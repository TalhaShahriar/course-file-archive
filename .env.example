# Server Configuration
PORT=3000
NODE_ENV=production

# Neon PostgreSQL Database Connection URL
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require

# Cloudflare R2 / AWS S3 Compatible Object Storage
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=course-file-archive
R2_ACCESS_KEY_ID=<your_r2_access_key_id>
R2_SECRET_ACCESS_KEY=<your_r2_secret_access_key>

# Optional: Google OAuth Client ID
# VITE_GOOGLE_CLIENT_ID=<your_google_oauth_client_id>
